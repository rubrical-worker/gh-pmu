{
  "processFramework": "IDPF-Agile",
  "domainSpecialist": "API-Integration-Specialist",
  "reviewMode": "solo",
  "projectSkills": [
    "anti-pattern-analysis",
    "codebase-analysis",
    "command-spec-audit",
    "diff-review",
    "drawio-generation",
    "electron-cross-build",
    "electron-development",
    "error-handling-patterns",
    "mutation-testing",
    "tdd-failure-recovery",
    "tdd-green-phase",
    "tdd-process",
    "tdd-red-phase",
    "tdd-refactor-coverage-audit",
    "tdd-refactor-phase",
    "test-scaffold",
    "test-writing-patterns"
  ],
  "frameworkVersion": "0.109.1",
  "frameworkPath": ".claude/framework",
  "$schema": "framework-config.schema.json",
  "reviewSweep": "full",
  "testing": {
    "suites": [
      {
        "id": "go-test",
        "role": "unit",
        "kind": "framework",
        "match": [
          "**/*.go"
        ],
        "full": "go test ./...",
        "scoped": {
          "mode": "package"
        }
      },
      {
        "id": "go-subprocess-e2e",
        "role": "e2e",
        "kind": "framework",
        "execution": "manual-only",
        "match": [
          "test/e2e/**/*.go"
        ],
        "full": "go test -tags e2e ./test/e2e/ -v",
        "note": "Live GitHub API; requires gh auth. Run locally before release, never from CI or /work (#876)."
      },
      {
        "id": "go-test-integration",
        "role": "integration",
        "kind": "framework",
        "execution": "manual-only",
        "full": "go test -tags=integration ./...",
        "scoped": {
          "mode": "package"
        },
        "note": "Live GitHub API calls; never run from CI or /work (#876)."
      },
      {
        "id": "go-vet",
        "role": "compile-check",
        "kind": "script",
        "match": [
          "**/*.go"
        ],
        "full": "go vet -tags \"integration e2e\" ./...",
        "scoped": {
          "mode": "package"
        }
      },
      {
        "id": "golangci-lint",
        "role": "compile-check",
        "kind": "script",
        "match": [
          "**/*.go"
        ],
        "full": "golangci-lint run --timeout=5m ./...",
        "scoped": {
          "mode": "package"
        }
      }
    ]
  }
}
